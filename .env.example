# Shared local development defaults. Copy to .env for local overrides.
COMPOSE_PROJECT_NAME=pnw-student-information-chatbot

POSTGRES_USER=pnw
POSTGRES_PASSWORD=pnw_dev_password
POSTGRES_DB=pnw_chatbot
DATABASE_URL=postgresql+psycopg://pnw:pnw_dev_password@localhost:5432/pnw_chatbot

BACKEND_PORT=8000
FRONTEND_PORT=5173
ALLOWED_ORIGINS=http://localhost:5173
