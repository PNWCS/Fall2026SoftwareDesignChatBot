# Backend-only local configuration. Never commit a populated .env file.
DATABASE_URL=postgresql+psycopg://pnw:pnw_dev_password@localhost:5432/pnw_chatbot
ALLOWED_ORIGINS=http://localhost:5173

REQUEST_MAX_BYTES=16384
ANONYMOUS_RATE_LIMIT_PER_MINUTE=20

# Configure this value locally through an untracked .env or secret manager.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.0
GEMINI_TIMEOUT_SECONDS=30

EMBEDDING_MODEL=text-embedding-004
EMBEDDING_DIMENSION=768
SOURCE_REVIEW_WINDOW_DAYS=180
CONVERSATION_TTL_SECONDS=1800
